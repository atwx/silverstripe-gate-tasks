{
    "name": "atwx/silverstripe-gate-tasks",
    "description": "Run build tasks on a SilverGate managed site, and pull its data, from your own command line.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "cms",
        "module",
        "cli",
        "silverstripe-gate",
        "atwx"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Atwx\\GateTasks\\": "src/"
        }
    },
    "extra": {
        "expose": []
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
